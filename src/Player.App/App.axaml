<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Player.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- One Button theme for every button in the app; variants are classes (see Styles below). -->
      <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="FocusAdorner" Value="{x:Null}" /> <!-- own ring: Border#focus -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
              <Border Name="hover" Background="White" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0">
                <Border.Transitions>
                  <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
                </Border.Transitions>
              </Border>
              <Border Name="focus" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{DynamicResource FocusRing}"
                      BorderThickness="2" IsVisible="False" />
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#hover"><Setter Property="Opacity" Value="0.07" /></Style>
        <Style Selector="^:pressed /template/ Border#hover"><Setter Property="Opacity" Value="0.12" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
        <Style Selector="^:focus-visible /template/ Border#focus"><Setter Property="IsVisible" Value="True" /></Style>
      </ControlTheme>

      <!-- One RadioButton theme: .card (presets), .tab (panel tabs), .nav (settings menu). -->
      <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="FocusAdorner" Value="{x:Null}" /> <!-- own ring: Border#focus -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
              <Border Name="hover" Background="White" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
              <Border Name="focus" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{DynamicResource FocusRing}"
                      BorderThickness="2" IsVisible="False" />
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#hover"><Setter Property="Opacity" Value="0.04" /></Style>
        <Style Selector="^:focus-visible /template/ Border#focus"><Setter Property="IsVisible" Value="True" /></Style>

        <Style Selector="^.card">
          <Setter Property="MinHeight" Value="84" />
          <Setter Property="Padding" Value="10,10,10,12" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="Background" Value="{DynamicResource Fill1}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
          <Setter Property="BorderThickness" Value="1.5" />
          <Setter Property="Foreground" Value="{DynamicResource Fg}" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="^.card:checked">
          <Setter Property="Background" Value="{DynamicResource AccentTint}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="^.tab">
          <Setter Property="Height" Value="34" />
          <Setter Property="CornerRadius" Value="9" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="^.tab:checked">
          <Setter Property="Background" Value="{DynamicResource Tab}" />
          <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="^.nav">
          <Setter Property="Height" Value="40" />
          <Setter Property="Padding" Value="12,0" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="^.nav:checked">
          <Setter Property="Background" Value="{DynamicResource Fill5}" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
    </Style>

    <!-- Icons -->
    <Style Selector="Viewbox.i14"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /></Style>
    <Style Selector="Viewbox.i16"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></Style>
    <Style Selector="Viewbox.i18"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /></Style>
    <Style Selector="Viewbox.i19"><Setter Property="Width" Value="19" /><Setter Property="Height" Value="19" /></Style>
    <Style Selector="Viewbox.i20"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /></Style>
    <Style Selector="Viewbox.i22"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /></Style>
    <Style Selector="Viewbox.i28"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /></Style>
    <Style Selector="Viewbox Path">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
      <Setter Property="StrokeThickness" Value="1.75" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Viewbox Path.fill">
      <Setter Property="Fill" Value="{Binding $parent[TemplatedControl].Foreground}" />
      <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <Style Selector="Viewbox Path.bold"><Setter Property="StrokeThickness" Value="2" /></Style>
    <Style Selector="RadioButton.nav:checked Path"><Setter Property="Stroke" Value="{DynamicResource Accent}" /></Style>

    <!-- Text -->
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Run.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Grouped rows (panels and settings) -->
    <Style Selector="Border.group">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Fill2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="14,0,10,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.row:nth-last-child(1)"><Setter Property="BorderThickness" Value="0" /></Style>

    <!-- Button variants -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.icon.on">
      <Setter Property="Background" Value="{DynamicResource AccentPress}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.round">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0B0C12" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Button.play /template/ Border#bg">
      <Setter Property="BoxShadow" Value="0 8 24 0 #66000000, 0 0 0 6 #14FFFFFF" />
    </Style>
    <Style Selector="Button.win">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Fill4}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="{DynamicResource Fill6}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.pill.accent">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.pill.white">
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="18,0,24,0" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0B0C12" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.pill.glass">
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="Background" Value="#29FFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.pill.small">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Fill6}" />
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.chip.on">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.drop">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0,10,0" />
      <Setter Property="Background" Value="{DynamicResource Fill4}" />
    </Style>
    <Style Selector="Button.drop.round">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="BorderBrush" Value="#24FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.outline.on">
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.link:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="Button.link /template/ Border#hover"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Button.step">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Button.swatch.on /template/ Border#bg">
      <Setter Property="BoxShadow" Value="0 0 0 2 #16191F, 0 0 0 4 #FFFFFF" />
    </Style>
    <Style Selector="Button.channel">
      <Setter Property="Width" Value="84" />
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Fill3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.channel.on">
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="ToggleButton.switch">
      <Setter Property="Theme" Value="{StaticResource Switch}" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#33000000" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line3}" />
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement, TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#4D000000" />
    </Style>

    <Style Selector="ProgressBar.thin">
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="Height" Value="4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="#F514171F" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line3}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
    </Style>
    <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
      <Setter Property="Background" Value="#F514171F" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line3}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="BoxShadow" Value="0 12 32 0 #80000000" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource Line2}" />
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="Height" Value="1" />
    </Style>
  </Application.Styles>
</Application>
