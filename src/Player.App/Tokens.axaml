<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens (Media Player Tasarımı.html). Accent brushes are replaced at runtime by App.SetAccent. -->
  <SolidColorBrush x:Key="Accent" Color="#6D5AE6" />
  <SolidColorBrush x:Key="AccentTint" Color="#2E6D5AE6" />   <!-- 18 %: selected cards -->
  <SolidColorBrush x:Key="AccentChip" Color="#3D6D5AE6" />   <!-- 24 %: chips -->
  <SolidColorBrush x:Key="AccentSoft" Color="#476D5AE6" />   <!-- 28 %: icon tiles -->
  <SolidColorBrush x:Key="AccentPress" Color="#4D6D5AE6" />  <!-- 30 %: pressed buttons -->
  <SolidColorBrush x:Key="AccentHalo" Color="#596D5AE6" />   <!-- 35 %: seek thumb halo -->
  <SolidColorBrush x:Key="AccentText" Color="#8373EA" />     <!-- accent as text, >= 4.5:1 on Sheet (ColorContrast.Lighten) -->
  <SolidColorBrush x:Key="FocusRing" Color="#8373EA" />      <!-- keyboard focus outline -->
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />       <!-- text on an accent fill -->

  <SolidColorBrush x:Key="Bg" Color="#0B0C12" />
  <SolidColorBrush x:Key="Surface" Color="#0E1014" />
  <SolidColorBrush x:Key="HeaderBg" Color="#111318" />
  <SolidColorBrush x:Key="Sheet" Color="#16191F" />
  <SolidColorBrush x:Key="SheetNav" Color="#121419" />
  <SolidColorBrush x:Key="Panel" Color="#B80E1016" />
  <SolidColorBrush x:Key="Glass" Color="#990E1016" />
  <SolidColorBrush x:Key="Tab" Color="#2A2F38" />

  <SolidColorBrush x:Key="Fg" Color="#ECEEF2" />
  <SolidColorBrush x:Key="Fg2" Color="#C2C8D0" />
  <SolidColorBrush x:Key="Fg3" Color="#A4ABB6" />
  <SolidColorBrush x:Key="Fg4" Color="#8E96A2" />
  <SolidColorBrush x:Key="Danger" Color="#FF8A80" />

  <SolidColorBrush x:Key="Line" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Line2" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Line3" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Fill1" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="Fill2" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="Fill3" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="Fill4" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Fill5" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Fill6" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Fill8" Color="#29FFFFFF" />

  <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Nuvora#Manrope</FontFamily>
  <FontFamily x:Key="Mono">fonts:Nuvora#IBM Plex Mono</FontFamily>

