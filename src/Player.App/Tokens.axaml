  <StreamGeometry x:Key="IcoFolder">M3 8a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</StreamGeometry>
  <StreamGeometry x:Key="IcoSubs">M6 5h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3z M7 13h4 M13 13h4 M7 16h7</StreamGeometry>
  <StreamGeometry x:Key="IcoTune">M4 7h10 M18 7h2 M4 17h4 M12 17h8 M14 7a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M8 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0</StreamGeometry>
  <StreamGeometry x:Key="IcoCamera">M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a1 1 0 0 1 1-1z M8.5 13a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0</StreamGeometry>
  <StreamGeometry x:Key="IcoBack">M4 12a8 8 0 1 0 2.5-5.8 M4 4v4.5h4.5</StreamGeometry>
  <StreamGeometry x:Key="IcoFwd">M20 12a8 8 0 1 1-2.5-5.8 M20 4v4.5h-4.5</StreamGeometry>
