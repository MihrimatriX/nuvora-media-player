<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Player.App"
             x:Class="Player.App.SettingsView"
             x:DataType="app:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="RadioButton.nav > StackPanel > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </UserControl.Styles>

  <!-- The control itself inherits PlayerViewModel; Root gets its own SettingsViewModel in code-behind. -->
  <Panel x:Name="Root">
    <Border Background="#9905060A" PointerPressed="OnBackdrop" />
    <Viewbox StretchDirection="DownOnly" Margin="24,60,24,24">
      <Border Width="920" Height="580" CornerRadius="22" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Line2}"
              BorderThickness="1" BoxShadow="0 30 80 0 #99000000" ClipToBounds="True">
        <Grid ColumnDefinitions="212,*">
          <!-- Navigation -->
          <Border Background="{DynamicResource SheetNav}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12,20">
            <StackPanel Spacing="4">
              <TextBlock Text="Ayarlar" FontSize="16" FontWeight="Bold" Margin="12,0,12,12" />
              <RadioButton Classes="nav" GroupName="page" IsChecked="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=genel}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Classes="i18"><Path Data="{StaticResource IcoGear}" StrokeThickness="2" /></Viewbox>
                  <TextBlock Text="Genel" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="nav" GroupName="page" IsChecked="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=video}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Classes="i18"><Path Data="{StaticResource IcoScreen}" StrokeThickness="1.8" /></Viewbox>
                  <TextBlock Text="Video &amp; FPS" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="nav" GroupName="page" IsChecked="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=ses}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Classes="i18">
                    <Panel>
                      <Path Data="{StaticResource IcoSpeaker}" StrokeThickness="1.8" />
                      <Path Data="{StaticResource IcoWave1}" StrokeThickness="1.8" />
                    </Panel>
                  </Viewbox>
                  <TextBlock Text="Ses" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="nav" GroupName="page" IsChecked="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=altyazi}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Classes="i18"><Path Data="{StaticResource IcoSubs}" StrokeThickness="1.8" /></Viewbox>
                  <TextBlock Text="Altyazı" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="nav" GroupName="page" IsChecked="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=disaaktar}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Classes="i18"><Path Data="{StaticResource IcoUpload}" StrokeThickness="1.8" /></Viewbox>
                  <TextBlock Text="Dışa Aktar" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="nav" GroupName="page" IsChecked="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=kisayollar}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Classes="i18"><Path Data="{StaticResource IcoKeyboard}" StrokeThickness="1.8" /></Viewbox>
                  <TextBlock Text="Kısayollar" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="nav" GroupName="page" IsChecked="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=hakkinda}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Classes="i18"><Path Data="{StaticResource IcoInfo}" StrokeThickness="1.8" /></Viewbox>
                  <TextBlock Text="Hakkında" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>

          <!-- Content -->
          <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Height="64" ColumnDefinitions="*,Auto" Margin="28,0,18,0">
              <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="close" Width="34" Height="34" CornerRadius="17" Command="{Binding CancelCommand}"
                      AutomationProperties.Name="Ayarları kapat">
                <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoClose}" /></Viewbox>
              </Button>
            </Grid>
            <Border DockPanel.Dock="Bottom" Height="64" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,0">
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="pill small" Padding="20,0" Content="Vazgeç" Background="{DynamicResource Fill5}" Command="{Binding CancelCommand}" />
                <Button Classes="pill small accent" Padding="24,0" Content="Kaydet" Command="{Binding SaveCommand}" />
              </StackPanel>
            </Border>

            <ScrollViewer Padding="28,0,28,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Panel>
                <!-- ================= GENEL ================= -->
                <StackPanel Spacing="14" IsVisible="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=genel}">
                  <TextBlock Classes="h3" Text="Genel Ayarlar" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Uygulama dili" />
                          <Button Grid.Column="1" Classes="drop" Click="OnLanguage">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="Türkçe" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <TextBlock Classes="label" Text="Tema ve vurgu rengi" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Name="Swatches" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                            <Button Classes="drop" Click="OnTheme">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ThemeText}" VerticalAlignment="Center" />
                                <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Uygulama penceresi her zaman üstte" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.AlwaysOnTop}" AutomationProperties.Name="Pencere her zaman üstte" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="SmartSeek (zaman çubuğu üzerinde anlık önizleme)" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.SmartSeek}" AutomationProperties.Name="SmartSeek" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Uygulamayı tam ekran kipinde başlat" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.StartFullscreen}" AutomationProperties.Name="Tam ekranda başlat" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Oynatma sırasında üst başlık çubuğunu gizle" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.HideTopBar}" AutomationProperties.Name="Üst menüyü gizle" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Güncellemeleri otomatik denetle" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.CheckUpdates}" AutomationProperties.Name="Güncellemeleri denetle" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Oynatma Ayarları" Margin="0,4,0,0" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Klasördeki sonraki dosyayı otomatik aç" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.AutoNext}" AutomationProperties.Name="Sonraki dosyayı otomatik aç" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Oynatmaya kaldığı yerden otomatik devam et" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.Resume}" AutomationProperties.Name="Kaldığı yerden devam et" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Video açıldığında tam ekran kipinde başlat" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.PlayInFullscreen}" AutomationProperties.Name="Video açıldığında tam ekranda başlat" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Pencereyi açılan videonun boyutuna sığdır" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.FitWindowToVideo}" AutomationProperties.Name="Pencereyi videoya sığdır" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Atlama aralığı (ileri / geri sarma)" />
                          <Button Grid.Column="1" Classes="drop" Click="OnSeekStep">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="mono" Text="{Binding SeekStepText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Varsayılan tekrarlama kipi" />
                          <Button Grid.Column="1" Classes="drop" Click="OnLoopMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding LoopModeText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Video üzerinde fare tekerleği işlevi" />
                          <Button Grid.Column="1" Classes="drop" Click="OnWheelAction">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding WheelActionText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Kare Yakalama ve Geçmiş" Margin="0,4,0,0" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <TextBlock Classes="label" Text="Kare yakalama klasörü" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBox Classes="field" Width="280" Text="{Binding Draft.ScreenshotDirectory}" AutomationProperties.Name="Kare yakalama klasörü" />
                            <Button Classes="drop" Width="36" Height="36" Padding="0" Click="OnPickFolder" ToolTip.Tip="Klasör seç" AutomationProperties.Name="Klasör seç">
                              <Viewbox Classes="i16"><Path Data="{StaticResource IcoFolder}" StrokeThickness="1.9" /></Viewbox>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Son oynatılanlar geçmişi" />
                          <Button Grid.Column="1" Classes="outline" Content="Geçmişi temizle" Command="{Binding ClearHistoryCommand}" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Windows Varsayılan Oynatıcı ve Dosya İlişkilendirme" Margin="0,4,0,0" IsVisible="{Binding CanRegisterDefault}" />
                  <Border Classes="group" Padding="16,14" IsVisible="{Binding CanRegisterDefault}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Tüm medya formatlarıyla ilişkilendir" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DefaultStatus}" FontSize="12" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" LineHeight="17" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="link" Content="Kaydı kaldır" FontSize="12" Padding="8,0"
                                Command="{Binding UnregisterDefaultCommand}" IsVisible="{Binding IsDefaultRegistered}" />
                        <Button Classes="outline" Content="Varsayılan oynatıcı yap" Command="{Binding RegisterDefaultCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- ================= VIDEO & FPS ================= -->
                <StackPanel Spacing="14" IsVisible="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=video}">
                  <TextBlock Classes="h3" Text="Donanım Hızlandırma ve Tarama Çözme (Deinterlacing)" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="Donanım hızlandırmayı kullan (GPU Zero-Copy)" />
                            <TextBlock Text="NVIDIA PureVideo / NVDEC, Direct3D 11 ve Intel QuickSync ile en düşük CPU kullanımı" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.HardwareDecoding}" AutomationProperties.Name="Donanım hızlandırmalı kod çözme" />
                        </Grid>
                      </Border>
                      <Border Classes="row" IsEnabled="{Binding Draft.HardwareDecoding}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Donanım kod çözücü kipi" />
                          <Button Grid.Column="1" Classes="drop" Click="OnHwdecMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding HwdecModeText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Tarama çözme (Deinterlacing)" />
                          <Button Grid.Column="1" Classes="drop" Click="OnDeinterlaceMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding DeinterlaceModeText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Video çıkış sürücüsü" />
                          <Button Grid.Column="1" Classes="drop" Click="OnVideoOutput">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding VideoOutputText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Motion² ve Yüksek Kare Hızı (24 → 60/90/120 FPS)" Margin="0,4,0,0" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="Varsayılan hedef kare hızı (FPS)" />
                            <TextBlock Text="24/25/30 FPS videoları gerçek zamanlı akıcı yüksek kare hızına dönüştürür" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="drop" Click="OnTargetFps">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="mono" Text="{Binding TargetFpsText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="Motion² UHD / 4K yüksek kare hızı işleme" />
                            <TextBlock Text="4K/UHD videolarda sıfır kopyalama ile doğrudan GPU shader üzerinde akıcı kare üretir" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.Motion2Uhd4K}" AutomationProperties.Name="Motion2 UHD/4K" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Otomatik tarama (interlace) algılama" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.AutoInterlaceDetection}" AutomationProperties.Name="Otomatik tarama algılama" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Hareket yumuşatma algoritması (tscale)" />
                          <Button Grid.Column="1" Classes="drop" Click="OnMotionScaler">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding MotionScalerText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Varsayılan görüntü ölçekleyici ve keskinlik" />
                          <Button Grid.Column="1" Classes="drop" Click="OnDefaultPreset">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding DefaultPresetText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="GPU shader katmanı" />
                            <TextBlock Text="Dengeli: FSRCNNX, Anime: Anime4K, Maksimum: ArtCNN. Yalnızca video büyütülürken çalışır" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.ShaderUpscaling}" AutomationProperties.Name="GPU shader katmanı" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="GPU yetişemezse otomatik düşür" />
                            <TextBlock Text="Kare düşerse daha hafif katmana, sonra yerleşik ölçekleyiciye geçer" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.AutoFallback}" AutomationProperties.Name="Otomatik düşüş" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="HDR ton eşleme (Tone Mapping)" />
                          <Button Grid.Column="1" Classes="drop" Click="OnToneMapping">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding ToneMappingText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Tam Ekran ve Görüntüleme Biçimi (Display Format)" Margin="0,4,0,0" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Ekran formatı" />
                          <Button Grid.Column="1" Classes="drop" Click="OnScreenFormat">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="mono" Text="{Binding ScreenFormatText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="4:3 video görünümü" />
                          <Button Grid.Column="1" Classes="drop" Click="OnDisplayFormat43">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding DisplayFormat43Text}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="16:9 video görünümü" />
                          <Button Grid.Column="1" Classes="drop" Click="OnDisplayFormat169">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding DisplayFormat169Text}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Sinematik (21:9) video görünümü" />
                          <Button Grid.Column="1" Classes="drop" Click="OnDisplayFormatCinematic">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding DisplayFormatCinematicText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- ================= SES ================= -->
                <StackPanel Spacing="14" IsVisible="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=ses}">
                  <TextBlock Classes="h3" Text="Ses Çıkış Kipi, Kanal Düzeni ve Bitstream" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="Ses çıkış kipi (Kanal ve Bitstream)" />
                            <TextBlock Text="Stereo, Stereo Surround, 5.1, 7.1, S/PDIF Bitstream veya HDMI Bitstream" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="drop" Click="OnAudioOutputMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding AudioOutputModeText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <TextBlock Classes="label" Text="Ana ses çıkış cihazı" />
                          <Button Grid.Column="1" Classes="drop" MaxWidth="320" Click="OnAudioDevice">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding AudioDeviceText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <TextBlock Classes="label" Text="S/PDIF Bitstream çıkış cihazı (AC-3 / DTS)" />
                          <Button Grid.Column="1" Classes="drop" MaxWidth="320" Click="OnSpdifDevice">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SpdifDeviceText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <TextBlock Classes="label" Text="HDMI Bitstream çıkış cihazı (TrueHD / DTS-HD / E-AC-3)" />
                          <Button Grid.Column="1" Classes="drop" MaxWidth="320" Click="OnHdmiDevice">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding HdmiDeviceText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Özel ses kipi (WASAPI Exclusive)" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.AudioExclusive}" AutomationProperties.Name="Özel kip" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Dudak Senkronizasyonu (Lipsync Adjustment)" Margin="0,4,0,0" />
                  <Border Classes="group" Padding="16,14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="label" Text="Ses gecikmesi / dudak senkronizasyonu" />
                          <TextBlock Text="Ses ve görüntü arasındaki senkron farkını milisaniye cinsinden ayarlar (−500 ms … +500 ms)" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding LipsyncText}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="link" Content="Sıfırla" FontSize="12" Command="{Binding ResetLipsyncCommand}" VerticalAlignment="Center" />
                      </Grid>
                      <Slider Minimum="-500" Maximum="500" Value="{Binding LipsyncValue}" />
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Ses İyileştirme ve Dil Tercihleri" Margin="0,4,0,0" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Ses düzeyi değiştirme adımı" />
                          <Button Grid.Column="1" Classes="drop" Click="OnVolumeStep">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="mono" Text="{Binding VolumeStepText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Ses yükseltme (%200 Boost) varsayılan olarak açık başlasın" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.BoostByDefault}" AutomationProperties.Name="Ses yükseltme açık başlasın" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Ses normalizasyonu (dynaudnorm) varsayılan olarak açık başlasın" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.NormalizeByDefault}" AutomationProperties.Name="Ses normalizasyonu açık başlasın" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="Tercih edilen ses dilleri" />
                            <TextBlock Text="Virgülle ayrılmış ISO dil kodları (örn. tur,eng,jpn)" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Classes="field" Width="220" Text="{Binding Draft.AudioLanguages}" Watermark="tur,eng,jpn" AutomationProperties.Name="Tercih edilen ses dilleri" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- ================= ALTYAZI ================= -->
                <StackPanel Spacing="14" IsVisible="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=altyazi}">
                  <TextBlock Classes="h3" Text="Altyazı Görünümü ve Dil Tercihleri" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="Tercih edilen altyazı dilleri" />
                            <TextBlock Text="Virgülle ayrılmış ISO dil kodları (örn. tur,eng)" FontSize="11.5" Foreground="{DynamicResource Fg3}" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Classes="field" Width="220" Text="{Binding Draft.SubtitleLanguages}" Watermark="tur,eng" AutomationProperties.Name="Tercih edilen altyazı dilleri" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Altyazı boyutu" />
                          <Button Grid.Column="1" Classes="drop" Click="OnSubtitleScale">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="mono" Text="{Binding SubtitleScaleText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Altyazı rengi" />
                          <Button Grid.Column="1" Classes="drop" Click="OnSubtitleColor">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SubtitleColorText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Altyazı dikey konumu" />
                          <Button Grid.Column="1" Classes="drop" Click="OnSubtitlePos">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SubtitlePosText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Yarı saydam arka plan kutusu" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.SubtitleBackground}" AutomationProperties.Name="Yarı saydam arka plan kutusu" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="ASS/SSA altyazı stillerini standart yazı tipiyle geçersiz kıl" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.OverrideAssStyles}" AutomationProperties.Name="ASS altyazı stillerini geçersiz kıl" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Klasördeki eşleşen altyazı dosyalarını otomatik yükle" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.AutoLoadSubtitles}" AutomationProperties.Name="Altyazıları otomatik yükle" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- ================= DIŞA AKTAR (EXPORT) ================= -->
                <StackPanel Spacing="14" IsVisible="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=disaaktar}">
                  <TextBlock Classes="h3" Text="Donanım Hızlandırma (Hardware Acceleration)" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Video kod çözme (decoding) için donanım hızlandırmayı kullan" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.ExportHwDecode}" AutomationProperties.Name="Dışa aktarma donanım kod çözme" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Video kodlama (encoding) için donanım hızlandırmayı kullan" />
                          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Draft.ExportHwEncode}" AutomationProperties.Name="Dışa aktarma donanım kodlama" />
                        </Grid>
                      </Border>
                      <Border Classes="row" IsEnabled="{Binding Draft.ExportHwEncode}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Donanım video kodlayıcı (Encoder)" />
                          <Button Grid.Column="1" Classes="drop" Click="OnExportEncoder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding ExportEncoderText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Dışa aktarma tarama çözme (Deinterlacing)" />
                          <Button Grid.Column="1" Classes="drop" Click="OnExportDeinterlace">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding ExportDeinterlaceText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="h3" Text="Dışa Aktarma Klasörü ve Çıktı Ayarları" Margin="0,4,0,0" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <TextBlock Classes="label" Text="Dışa aktarma çıktı klasörü" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBox Classes="field" Width="280" Text="{Binding Draft.ExportDirectory}" AutomationProperties.Name="Dışa aktarma klasörü" />
                            <Button Classes="drop" Width="36" Height="36" Padding="0" Click="OnPickExportFolder" ToolTip.Tip="Klasör seç" AutomationProperties.Name="Dışa aktarma klasörü seç">
                              <Viewbox Classes="i16"><Path Data="{StaticResource IcoFolder}" StrokeThickness="1.9" /></Viewbox>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Kare dışa aktarma dosya biçimi" />
                          <Button Grid.Column="1" Classes="drop" Click="OnScreenshotFormat">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="mono" Text="{Binding ScreenshotFormatText}" VerticalAlignment="Center" />
                              <Viewbox Classes="i14"><Path Classes="bold" Data="{StaticResource IcoChevron}" /></Viewbox>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="Hızlı işlemler" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="outline" Content="Çıktı klasörünü aç" Command="{Binding Player.OpenExportFolderCommand}" />
                            <Button Classes="outline on" Content="Mevcut kareyi dışa aktar" Command="{Binding Player.ExportCurrentFrameCommand}"
                                    IsEnabled="{Binding !Player.IsIdle}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- ================= KISAYOLLAR ================= -->
                <StackPanel Spacing="12" IsVisible="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=kisayollar}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h3" Text="Klavye Kısayolları" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="link" Content="Varsayılanlara sıfırla" FontSize="12" Command="{Binding ResetShortcutsCommand}" />
                  </Grid>
                  <Border Classes="group" Padding="4">
                    <ItemsControl ItemsSource="{Binding ShortcutItems}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:ShortcutItem">
                          <Border Padding="12,0" Height="40" CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="{Binding Action.Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <Button Grid.Column="1" Classes="chip" Classes.on="{Binding IsCapturing}" VerticalAlignment="Center" Content="{Binding KeyText}"
                                      Command="{Binding #Root.((app:SettingsViewModel)DataContext).StartCaptureCommand}"
                                      CommandParameter="{Binding}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <TextBlock Text="Değiştirmek için tuş kutusuna tıklayın · Kaldırmak için Backspace · İptal için Esc"
                             FontSize="12" Foreground="{DynamicResource Fg3}" />
                </StackPanel>

                <!-- ================= HAKKINDA ================= -->
                <StackPanel Spacing="14" IsVisible="{Binding Page, Converter={x:Static app:EqualsConverter.Instance}, ConverterParameter=hakkinda}">
                  <Border Classes="group" Padding="18,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Accent}">
                        <Path Data="M24 13L34 31H14Z" Stroke="White" StrokeThickness="3" StrokeJoin="Round" />
                      </Border>
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Nuvora Player" FontSize="18" FontWeight="Bold" />
                        <TextBlock Classes="mono" Text="{Binding Version, StringFormat='Sürüm {0} · Modern Windows Medya Oynatıcı'}" Foreground="{DynamicResource Fg3}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="label" Text="Oynatma motoru" />
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Player.MpvVersion}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="label" Text="Aktif grafik işlemci (GPU)" />
                          <TextBlock Grid.Column="1" Text="{Binding Player.GpuName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                        </Grid>
                      </Border>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="label" Text="Desteklenen formatlar" />
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SupportedFormatCount, StringFormat='{}{0}+ video, ses, altyazı ve oynatma listesi formatı'}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                  <TextBlock FontSize="12" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" LineHeight="18"
                             Text="libmpv, FFmpeg, Avalonia UI, Manrope ve IBM Plex Mono üzerine kuruludur. Tüm açık kaynak bileşen lisansları THIRD_PARTY.md dosyasındadır." />
                </StackPanel>
              </Panel>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Viewbox>
  </Panel>
</UserControl>
