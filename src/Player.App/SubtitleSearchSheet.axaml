<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Player.App"
             xmlns:core="using:Player.Core"
             x:Class="Player.App.SubtitleSearchSheet"
             x:DataType="app:PlayerViewModel">
  <Border Width="600" MaxHeight="520" CornerRadius="24" Background="#F210121A"
          BorderBrush="{DynamicResource Line3}" BorderThickness="1"
          BoxShadow="0 24 64 0 #99000000" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,20">
      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Viewbox Classes="i20" VerticalAlignment="Center">
              <Path Data="{StaticResource IcoSubs}" Stroke="{DynamicResource Accent}" />
            </Viewbox>
            <TextBlock Text="Çevrimiçi Altyazı Ara" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Fg}" />
          </StackPanel>
          <TextBlock Text="OpenSubtitles veritabanından altyazı bulun ve tek tıkla videoya uygulayın."
                     FontSize="12" Foreground="{DynamicResource Fg3}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="close" Command="{Binding CloseSubtitleSearchCommand}"
                ToolTip.Tip="Kapat (Esc)" AutomationProperties.Name="Kapat">
          <Viewbox Classes="i16"><Path Data="{StaticResource IcoClose}" /></Viewbox>
        </Button>
      </Grid>

      <!-- Search bar & Language selector -->
      <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Classes="field" Text="{Binding SubtitleQuery}" Watermark="Film, dizi veya sürüm adı ara…"
                   KeyDown="OnQueryKeyDown" />
          <Button Grid.Column="1" Classes="pill accent" Command="{Binding SearchSubtitlesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Ara" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <RadioButton Classes="tab" Content="Türkçe (TR)" IsChecked="{Binding SubtitleLang, Converter={x:Static app:SubtitleSearchSheet.IsTur}}"
                         Click="OnSetLangTur" />
            <RadioButton Classes="tab" Content="İngilizce (EN)" IsChecked="{Binding SubtitleLang, Converter={x:Static app:SubtitleSearchSheet.IsEng}}"
                         Click="OnSetLangEng" />
            <RadioButton Classes="tab" Content="Tüm Diller" IsChecked="{Binding SubtitleLang, Converter={x:Static app:SubtitleSearchSheet.IsAll}}"
                         Click="OnSetLangAll" />
          </StackPanel>
          <TextBlock Grid.Column="2" Classes="mono" Text="{Binding SubtitleSearchStatus}"
                     FontSize="11.5" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <!-- Subtitles list -->
      <ScrollViewer Grid.Row="2" MaxHeight="300" Margin="0,0,-8,0" Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding SubtitleResults}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:SubtitleItem">
              <Border Padding="12,10" CornerRadius="14" Background="{DynamicResource Fill2}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <!-- Lang badge -->
                  <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentTint}"
                          BorderBrush="{DynamicResource Accent}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Classes="mono" Text="{Binding LangBadge}" FontSize="12" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>

                  <!-- Info -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="mono" Text="{Binding StatsText}" FontSize="11" Foreground="{DynamicResource Fg4}" />
                  </StackPanel>

                  <!-- Download button -->
                  <Button Grid.Column="2" Classes="pill small accent" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((app:PlayerViewModel)DataContext).DownloadSubtitleCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="İndir ve Uygula" FontSize="12" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Footer note -->
      <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="10" Background="#08FFFFFF">
        <TextBlock Text="Altyazı dosyası indirildikten sonra anında videoya entegre edilir ve zaman senkronizasyonu korunur."
                   FontSize="11" Foreground="{DynamicResource Fg4}" TextAlignment="Center" />
      </Border>
    </Grid>
  </Border>
</UserControl>

